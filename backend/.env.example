# ============================================================================
# SaaS RAG Chatbot Application - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=True

# ============================================================================
# DATABASE SETTINGS (PostgreSQL)
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_chatbot_db

# ============================================================================
# QDRANT VECTOR STORE
# ============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=  # Optional: leave empty for local Qdrant

# ============================================================================
# SECURITY
# ============================================================================
# Generate a secure random secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production

# ============================================================================
# CORS ORIGINS (comma-separated list of allowed frontend URLs)
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ============================================================================
# LLM SETTINGS (OpenAI)
# ============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# EMAIL SETTINGS (SMTP)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@ragchatbot.com

# ============================================================================
# FRONTEND URL
# ============================================================================
FRONTEND_URL=http://localhost:3000

# ============================================================================
# LEMON SQUEEZY SETTINGS (Billing)
# ============================================================================
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here
LEMONSQUEEZY_STORE_ID=your_lemonsqueezy_store_id_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_secret_here
LEMONSQUEEZY_BASE_URL=https://api.lemonsqueezy.com/v1

# Product and variant IDs for different plans
LEMONSQUEEZY_FREE_VARIANT_ID=variant_id_for_free_plan
LEMONSQUEEZY_PRO_VARIANT_ID=variant_id_for_pro_plan
LEMONSQUEEZY_ENTERPRISE_VARIANT_ID=variant_id_for_enterprise_plan

# Checkout configuration
LEMONSQUEEZY_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
LEMONSQUEEZY_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel

# ============================================================================
# MONITORING (Optional)
# ============================================================================
SENTRY_DSN=  # Optional: Sentry DSN for error tracking

# ============================================================================
# ADDITIONAL NOTES
# ============================================================================
# 1. For Gmail SMTP, you need to use an "App Password" not your regular password
# 2. Generate JWT_SECRET_KEY using: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. For production, use environment-specific values and secure secret management
# 4. Ensure PostgreSQL and Qdrant are running before starting the application
# 5. Copy this file to .env and update the values before running the application

